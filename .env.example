# Variaveis lidas pelo docker-compose.yml para buildar o frontend.
# Copie para .env (mesma pasta) e preencha com os valores do projeto Firebase Web.
# Sao valores client-side (vao para o bundle do browser), nao segredos de servidor.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
